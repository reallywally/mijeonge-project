# docker-compose.yml 의 postgres 와 같은 값
DATABASE_URL=postgresql+asyncpg://innoflow:innoflow@localhost:5432/innoflow

# Vite 개발 서버. JSON 배열로 적는다
CORS_ORIGINS=["http://localhost:5173"]

SQL_ECHO=false

# AI 공급자 — anthropic(기본) · openai · groq. 고른 공급자의 키가 비면 앱은 뜨고 AI 경로만 503 CHAT_UNAVAILABLE 이다
# LLM_PROVIDER=anthropic

# Claude
ANTHROPIC_API_KEY=
# CHAT_MODEL=claude-sonnet-5-5
# CHAT_EFFORT=low

# GPT · Groq — 모델 id 는 기본값이 없어 꼭 적는다
# OPENAI_API_KEY=
# OPENAI_MODEL=
# GROQ_API_KEY=
# GROQ_MODEL=
